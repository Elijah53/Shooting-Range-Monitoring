# --- Database ---
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/shooting_range
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shooting_range
DB_USER=postgres
DB_PASSWORD=changeme

# --- Computer vision ---
# Path to a pretrained YOLO weapon-detection .pt file (ultralytics format).
# If this file does not exist, the app runs in "mock detection" mode.
WEAPON_MODEL_PATH=model_data/weapon_model.pt

# Webcam index (0 = default camera) or an RTSP/HTTP stream URL.
CAMERA_SOURCE=0

# --- Detection tuning ---
FACE_MATCH_THRESHOLD=0.6
DETECTION_CONFIDENCE_THRESHOLD=0.5
EVENT_COOLDOWN_SECONDS=7
FACE_RECOGNITION_INTERVAL=10
